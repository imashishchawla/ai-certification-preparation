{
  "name": "ai-certification-preparation",
  "version": "1.0.0",
  "description": "Certification study guides, practice questions, and mock tests in one website.",
  "main": "scripts/serve.mjs",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "hugo --minify && node scripts/build-browser-artifacts.mjs && node scripts/audit-rendered-pages.mjs && node scripts/seo-spider.mjs && node scripts/verify-site-build.mjs && node scripts/check-external-links.mjs",
    "validate": "node scripts/validate-questions.mjs",
    "report:weekly:preview": "node scripts/weekly-report.mjs --dry-run",
    "normalize": "node scripts/normalize-questions.mjs",
    "dedup": "node .agent/cert-prep-curator/cli.mjs dedup-db cca-f",
    "sync": "node .agent/cert-prep-curator/cli.mjs sync cca-f",
    "sync:all": "node .agent/cert-prep-curator/cli.mjs sync all",
    "preflight": "node .agent/cert-prep-curator/cli.mjs preflight",
    "curate": "node .agent/cert-prep-curator/cli.mjs curate cca-f",
    "curator": "node .agent/cert-prep-curator/cli.mjs"
  },
  "keywords": [
    "hugo",
    "ccaf",
    "ai-certification",
    "claude-certified-architect",
    "mock-exam"
  ],
  "author": "imashishchawla",
  "license": "MIT"
}
