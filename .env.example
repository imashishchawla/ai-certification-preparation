# ─────────────────────────────────────────────────────────────────────────────
# Local script development environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env (gitignored) and fill in your real values.
# Source it before running scripts locally:
#   source .env && node scripts/verify-live-release.mjs
#
# In GitHub Actions these are set as repo Variables (CURATOR_WORKER_URL)
# and repo Secrets (STATUS_HMAC_SECRET). See the Secret Key Topology table below.
#
# ─────────────────────────────────────────────────────────────────────────────

# The deployed Cloudflare Worker base URL (no trailing slash)
#   Repo Variable: CURATOR_WORKER_URL
#   Example:       https://cert-prep-curator-worker.team-revendum.workers.dev
CURATOR_WORKER_URL=https://cert-prep-curator-worker.team-revendum.workers.dev

# Shared HMAC hex secret — must match the value set in the Worker AND in GitHub
#   Repo Secret: STATUS_HMAC_SECRET
#   Generate:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATUS_HMAC_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
